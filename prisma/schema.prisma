datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum MarketplaceType {
  SHOPEE
  MERCADO_LIVRE
  AMAZON
  MAGALU
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model MarketplaceConnection {
  id               String            @id @default(uuid())
  type             MarketplaceType   @unique
  status           ConnectionStatus  @default(DISCONNECTED)
  apiKey           String?
  apiSecret        String?
  merchantId       String?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  lastSyncAt       DateTime?
  importedProducts Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  logs             MarketplaceLog[]
}

model MarketplaceLog {
  id           String                @id @default(uuid())
  connectionId String
  connection   MarketplaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  action       String                // Ex: "CONNECT", "SYNC", "TEST"
  status       String                // Ex: "SUCCESS", "FAILED"
  endpoint     String?
  statusCode   Int?
  requestData  String?               // JSON stringified
  responseData String?               // JSON stringified
  errorMessage String?
  createdAt    DateTime              @default(now())
}